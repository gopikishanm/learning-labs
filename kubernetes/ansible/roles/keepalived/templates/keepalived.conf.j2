vrrp_instance VI_1 {
    state MASTER
    interface {{ load_balancer_interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_password }}
    }
    virtual_ipaddress {
        {{ load_balancer_vip }}/{{ load_balancer_vip_prefix }}
    }
}